<Application x:Class="MQMeshUpdater.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <SolidColorBrush x:Key="HeaderBrush" Color="#14243B" />
        <SolidColorBrush x:Key="AccentBrush" Color="#0F9B8E" />
        <SolidColorBrush x:Key="AccentLightBrush" Color="#2DD4BF" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#F6F8FB" />
        <SolidColorBrush x:Key="BorderBrush" Color="#D9DFE7" />
        <SolidColorBrush x:Key="MutedBrush" Color="#5B6B7F" />
        <SolidColorBrush x:Key="GroupBrush" Color="#E9EEF4" />

        <SolidColorBrush x:Key="OkBrush" Color="#15803D" />
        <SolidColorBrush x:Key="UpdateBrush" Color="#B45309" />
        <SolidColorBrush x:Key="MissingBrush" Color="#B91C1C" />
        <SolidColorBrush x:Key="CustomBrush" Color="#7C3AED" />

        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0B7F75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#A9B6C4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlainButton" TargetType="Button">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        </Style>
    </Application.Resources>
</Application>
